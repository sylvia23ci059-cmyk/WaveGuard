# WaveGuard KGF Environment Configuration
# 3D Urban Flood Intelligence Platform for Kolar Gold Fields

# Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Database Configuration
# Local SQLite mode:
DATABASE_URL=sqlite:///./waveguard_kgf.db
# PostgreSQL / PostGIS target mode:
# DATABASE_URL=postgresql://waveguard_user:password@localhost:5432/waveguard_kgf

# Geospatial Projection Configuration
ANALYSIS_CRS=EPSG:32644   # WGS 84 / UTM zone 44N (Metric analysis)
DISPLAY_CRS=EPSG:4326    # WGS 84 Geographic (Web mapping)

# Study Area Bounding Box (KGF Taluk)
KGF_BBOX_WEST=78.22711411
KGF_BBOX_SOUTH=12.85804513
KGF_BBOX_EAST=78.47505995
KGF_BBOX_NORTH=13.08287342

# IoT Telemetry & MQTT Broker
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC_TELEMETRY=waveguard/kgf/sensors/telemetry
MQTT_TOPIC_ALERTS=waveguard/kgf/alerts
SIMULATOR_MODE=true # Emits explicitly tagged 'DEMONSTRATION DATA'

# Copernicus DEM Open Data AWS S3
COPERNICUS_DEM_S3_BUCKET=https://copernicus-dem-30m.s3.amazonaws.com/
TILE_N12=Copernicus_DSM_COG_10_N12_00_E078_00_DEM/Copernicus_DSM_COG_10_N12_00_E078_00_DEM.tif
TILE_N13=Copernicus_DSM_COG_10_N13_00_E078_00_DEM/Copernicus_DSM_COG_10_N13_00_E078_00_DEM.tif

# Meteorological Live Ingestion
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast
KGF_LATITUDE=12.96
KGF_LONGITUDE=78.27
