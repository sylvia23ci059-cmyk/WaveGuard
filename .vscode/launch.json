{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI Backend (port 8001)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "cwd": "${workspaceFolder}",
      "args": [
        "backend.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8001",
        "--reload"
      ],
      "jinja": true,
      "justMyCode": true
    }
  ]
}
