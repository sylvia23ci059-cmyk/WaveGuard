{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "1. Start Backend (FastAPI)",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe -m uvicorn backend.main:app --host 127.0.0.1 --port 8000 --reload",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "servers",
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "2. Start Frontend (Vite)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "servers",
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Start WaveGuard KGF (Full Stack)",
      "dependsOn": [
        "1. Start Backend (FastAPI)",
        "2. Start Frontend (Vite)"
      ],
      "dependsOrder": "parallel",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
